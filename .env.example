# Check WFCD releases and refresh the market catalogue every 180 minutes.
CATALOG_REFRESH_MINUTES=180

# Shared across all market requests and retries. Must be > 0 and <= 3.
WFM_REQUESTS_PER_SECOND=2.5

# Local execution defaults; Compose fixes these to :8080 and /data.
HTTP_ADDR=:8080
DATA_DIR=./data
