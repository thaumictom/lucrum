FROM rust:bookworm AS builder
WORKDIR /app

ENV CARGO_BUILD_JOBS=1 \
    CARGO_NET_RETRY=10 \
    CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse

COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN rustc --version \
    && cargo --version \
    && cargo build --release --locked -j 1

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates util-linux \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/target/release/lucrum /usr/local/bin/lucrum
COPY deploy/run-lucrum.sh /usr/local/bin/run-lucrum.sh
RUN chmod +x /usr/local/bin/run-lucrum.sh \
    && mkdir -p /app/data

CMD ["sleep", "infinity"]
