FROM oven/bun:debian

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates util-linux \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json bun.lock tsconfig.json ./
RUN bun install --frozen-lockfile --production
COPY src ./src
COPY deploy/lucrum /usr/local/bin/lucrum
COPY deploy/run-lucrum.sh /usr/local/bin/run-lucrum.sh
RUN chmod +x /usr/local/bin/lucrum /usr/local/bin/run-lucrum.sh \
    && mkdir -p /app/data \
    && chown -R bun:bun /app

USER bun
CMD ["sleep", "infinity"]
