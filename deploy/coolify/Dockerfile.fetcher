FROM rust:1-bookworm AS builder
WORKDIR /src

COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY sample.json ./sample.json

RUN cargo build --release

FROM debian:bookworm-slim
ARG SUPERCRONIC_VERSION=v0.2.44

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSLo /usr/local/bin/supercronic \
    https://github.com/aptible/supercronic/releases/download/${SUPERCRONIC_VERSION}/supercronic-linux-amd64 \
    && chmod +x /usr/local/bin/supercronic

WORKDIR /app

COPY --from=builder /src/target/release/lucrum /usr/local/bin/lucrum
COPY deploy/coolify/lucrum.cron /etc/lucrum.cron
COPY deploy/coolify/start-fetcher.sh /usr/local/bin/start-fetcher.sh

RUN mkdir -p /app/data \
    && chmod +x /usr/local/bin/start-fetcher.sh

ENV LUCRUM_REQUESTS_PER_SECOND=2.5

ENTRYPOINT ["/usr/local/bin/start-fetcher.sh"]
