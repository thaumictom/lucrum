[Unit]
Description=Lucrum Warframe Market scraper
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lucrum
Group=lucrum
WorkingDirectory=/opt/lucrum
Environment=LUCRUM_REQUESTS_PER_SECOND=2.5
ExecStart=/usr/bin/flock -n -E 0 /var/lock/lucrum.lock /opt/lucrum/target/release/lucrum
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/lucrum/data /var/lock

[Install]
WantedBy=multi-user.target
